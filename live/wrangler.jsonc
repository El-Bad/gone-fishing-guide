{
  // Cloudflare Worker: app + field guide as static assets, plus the gonefishing.gg API relay (worker/index.ts)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gone-fishing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,   // served at https://gone-fishing.elbad.workers.dev
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/gf-api/*"]
  },
  "observability": { "enabled": true }
}
