{
  "name": "gone-fishing-live",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-public.mjs",
    "dev": "vite",
    "build": "node scripts/prepare-public.mjs && tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.6.0",
    "vite": "^6.4.0",
    "vitest": "^3.0.0",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
